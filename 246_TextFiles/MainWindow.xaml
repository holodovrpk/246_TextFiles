<Window x:Class="_246_TextFiles.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_246_TextFiles"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <StackPanel>

        <ListBox x:Name="lbNames" Height="200" />
        <TextBox x:Name="txtName" />
        <Button Content="Добавить" Click="Button_Click"/>

        <Button Content="Открыть" Click="Open_Click"/>
        <Button Content="Сохранить" Click="Save_Click"/>
        
    </StackPanel>
</Window>
